---
import { format } from "date-fns";
import { fr } from "date-fns/locale";
import MapPanel from "../components/MapPanel.astro";
import {
  clubInfo,
  faqItems,
  getHomeAnnouncements,
  homeHighlights,
  trainingSchedule,
} from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const heroMeta = [
  clubInfo.city,
  "Lundi, mercredi et vendredi",
  "Sessions dès 17h00",
];

const homeAnnouncements = getHomeAnnouncements();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsClub",
      "@id": `${clubInfo.siteUrl}#club`,
      name: clubInfo.name,
      description:
        "Club de boxe anglaise à La Louvière pour débutants, pratiquants loisir et compétiteurs. Encadrement structuré, cours du soir et progression suivie.",
      url: clubInfo.siteUrl,
      image: `${clubInfo.siteUrl}/hero-boxe.jpg`,
      email: clubInfo.email,
      telephone: clubInfo.phoneHref,
      address: {
        "@type": "PostalAddress",
        streetAddress: clubInfo.addressLine,
        addressLocality: clubInfo.city,
        addressRegion: clubInfo.region,
        postalCode: clubInfo.postalCode,
        addressCountry: clubInfo.countryCode,
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: clubInfo.latitude,
        longitude: clubInfo.longitude,
      },
      sport: "Boxing",
      hasMap: clubInfo.googleMapsUrl,
      sameAs: clubInfo.socialLinks.map((link) => link.href),
      areaServed: clubInfo.areaServed.map((area) => ({
        "@type": "Place",
        name: area,
      })),
      openingHoursSpecification: trainingSchedule.flatMap((day) =>
        day.slots.map((slot) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: `https://schema.org/${day.schemaDay}`,
          opens: slot.opens,
          closes: slot.closes,
        }))
      ),
    },
    {
      "@type": "FAQPage",
      "@id": `${clubInfo.siteUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};

const schema = JSON.stringify(localBusinessSchema);
---

<BaseLayout
  title={`Club de boxe anglaise à ${clubInfo.city} | ${clubInfo.name}`}
  description={`Club de boxe anglaise à ${clubInfo.city} pour débutants, loisir et compétiteurs. Cours du soir, séance d'essai et encadrement structuré.`}
  image="/hero-boxe.jpg"
  schema={schema}
>
  <section class="hero">
    <div class="hero-decor-line"></div>
    <div class="hero-bg-name">COLAK</div>

    <div class="container">
      <div class="hero-shell">
        <div class="hero-main">
          <div class="hero-badge">
            <span class="line"></span>
            <span>BOXE ANGLAISE • {clubInfo.city.toUpperCase()}</span>
          </div>

          <h1 class="hero-title">
            <span>BOXING CLUB</span><br />
            <span class="text-stroke">COLAK</span>
          </h1>

          <p class="hero-lead">
            Débutants, loisir sérieux et compétition dans un cadre net, suivi et respecté.
          </p>

          <div class="hero-actions">
            <a href="/contact?sujet=essai" class="btn-main">SÉANCE D'ESSAI</a>
            <a href="#annonces" class="btn-secondary-link">VOIR LES ANNONCES</a>
          </div>

          <ul class="hero-meta">
            {heroMeta.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <strong class="stat-num">16+</strong>
          <span class="stat-label">Boxeurs actifs</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <strong class="stat-num">4</strong>
          <span class="stat-label">Boxeurs professionnels</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <strong class="stat-num">3</strong>
          <span class="stat-label">Séances par semaine</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <strong class="stat-num">LFB</strong>
          <span class="stat-label">Ligue Francophone de Boxe</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-intro">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-title-wrap">
          <span class="section-kicker">Le bon cadre</span>
          <h2 class="title-premium">
            Apprendre, reprendre ou pousser plus loin la boxe anglaise à {clubInfo.city}.
          </h2>
        </div>

        <div class="text-premium">
          <p>Technique, discipline, régularité. Le club s'adresse aux profils qui veulent progresser proprement.</p>
        </div>
      </div>

      <div class="highlights-grid">
        {homeHighlights.map((item) => (
          <article class="highlight-card reveal">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {homeAnnouncements.length > 0 && (
    <section class="section-news alt" id="annonces">
      <div class="container">
        <div class="header-flex">
          <h2 class="section-title-small">Annonces du club</h2>
          <div class="line"></div>
        </div>

        <div class="news-list">
          {homeAnnouncements.map((item) => (
            <article class={`news-alert ${item.urgent ? "is-urgent" : ""}`}>
              <div class="alert-badge-wrap">
                {item.urgent && <span class="alert-star">★</span>}
                <span class="alert-cat">{item.category}</span>
              </div>

              <div class="alert-content">
                <div class="alert-heading">
                  <h3 class="alert-title">{item.title}</h3>
                  <time class="alert-date" datetime={item.date}>
                    {format(new Date(item.date), "dd MMM yyyy", { locale: fr })}
                  </time>
                </div>
                <p class="alert-excerpt">{item.excerpt}</p>
                {item.details && (
                  <ul class="alert-pills">
                    {item.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                )}
              </div>

              <a href={item.link.href} class="alert-action">{item.link.label} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-schedule" id="horaires">
    <div class="container">
      <div class="schedule-header">
        <div>
          <span class="section-kicker">Organisation</span>
          <h2 class="section-title-center">Planning d'entraînement</h2>
        </div>
        <p class="schedule-copy"></p>
      </div>

      <div class="schedule-list">
        {trainingSchedule.map((day) => (
          <div class="schedule-item">
            <div class="item-day">{day.day}</div>
            <div class="item-slots">
              {day.slots.map((slot) => (
                <div class="item-slot">
                  <span class="item-type">{slot.audience}</span>
                  <span class="item-time">{slot.time}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-faq" id="faq">
    <div class="container">
      <div class="faq-header">
        <span class="section-kicker">Questions fréquentes</span>
        <h2 class="title-premium">Avant de venir</h2>
      </div>

      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item reveal">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-contact">
    <div class="container">
      <MapPanel
        title="Un club accessible depuis toute la région du Centre"
        subtitle={`Le ${clubInfo.name} est basé à ${clubInfo.city}. Accès simple, planning clair, contact direct.`}
        detailsTitle="Pratique locale"
      />
    </div>
  </section>

  <script is:inline>
    document.documentElement.classList.add("reveal-ready");

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  </script>

  <style>
    .hero {
      position: relative;
      overflow: hidden;
      padding: 156px 0 90px;
      background:
        radial-gradient(circle at top right, rgba(199, 157, 49, 0.16), transparent 28rem),
        #000;
    }

    .hero-decor-line {
      position: absolute;
      left: 5%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: rgba(199, 157, 49, 0.1);
      z-index: 1;
    }

    .hero-bg-name {
      position: absolute;
      right: -4vw;
      bottom: 2vh;
      font-family: var(--font-accent);
      font-size: 22vw;
      color: rgba(255, 255, 255, 0.03);
      line-height: 0.8;
      z-index: 0;
      pointer-events: none;
    }

    .hero-shell {
      position: relative;
      z-index: 1;
      max-width: 1120px;
    }

    .hero-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      color: var(--color-accent);
      font-family: var(--font-accent);
      font-size: 0.92rem;
      letter-spacing: 0.22em;
    }

    .hero-badge .line {
      width: 40px;
      height: 1px;
      background: var(--color-accent);
    }

    .hero-title {
      font-size: clamp(4rem, 10vw, 7.6rem);
      margin-bottom: 18px;
    }

    .hero-lead {
      max-width: 42rem;
      color: #c2c2c2;
      font-size: clamp(1rem, 1.7vw, 1.15rem);
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 22px;
      margin-top: 24px;
    }

    .btn-main {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      padding: 0 28px;
      background: var(--color-accent);
      color: #050505;
      font-family: var(--font-accent);
      font-size: 1.12rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      box-shadow: 0 18px 40px rgba(199, 157, 49, 0.22);
    }

    .btn-secondary-link {
      font-family: var(--font-accent);
      font-size: 1rem;
      letter-spacing: 0.08em;
      color: #fff;
      border-bottom: 1px solid var(--color-accent);
      padding-bottom: 4px;
      opacity: 0.85;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin-top: 20px;
    }

    .hero-meta li {
      position: relative;
      color: #d8d8d8;
      font-size: 0.95rem;
      line-height: 1.4;
      white-space: nowrap;
    }

    .hero-meta li:not(:last-child)::after {
      content: "";
      position: absolute;
      right: -10px;
      top: 50%;
      width: 3px;
      height: 3px;
      border-radius: 999px;
      background: rgba(199, 157, 49, 0.7);
      transform: translateY(-50%);
    }

    .stats-bar {
      background: rgba(199, 157, 49, 0.05);
      border-top: 1px solid rgba(199, 157, 49, 0.18);
      border-bottom: 1px solid rgba(199, 157, 49, 0.08);
      padding: 32px 0;
    }

    .stats-grid {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      padding: 0 52px;
    }

    .stat-num {
      color: var(--color-accent);
      font-family: var(--font-accent);
      font-size: 2.8rem;
      letter-spacing: 0.04em;
      line-height: 1;
    }

    .stat-label {
      color: #777;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
    }

    .stat-sep {
      width: 1px;
      height: 44px;
      background: rgba(255, 255, 255, 0.07);
      flex-shrink: 0;
    }

    .section-intro,
    .section-news,
    .section-schedule,
    .section-faq,
    .section-contact {
      padding: 78px 0;
    }

    .section-news.alt {
      background: rgba(255, 255, 255, 0.015);
    }

    .section-kicker {
      display: inline-flex;
      margin-bottom: 14px;
      color: var(--color-accent);
      font-family: var(--font-accent);
      font-size: 0.9rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .intro-grid,
    .schedule-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 28px;
      align-items: start;
    }

    .title-premium,
    .section-title-center {
      font-size: clamp(2.1rem, 4.8vw, 3.2rem);
      color: #fff;
      line-height: 1.05;
    }

    .text-premium,
    .schedule-copy {
      color: #b3b3b3;
      font-size: 1.02rem;
      line-height: 1.62;
    }

    .highlights-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 34px;
    }

    .highlight-card {
      padding: 24px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.025);
    }

    .highlight-card h3 {
      margin-bottom: 10px;
      color: #fff;
      font-size: 1.3rem;
    }

    .highlight-card p {
      color: #9d9d9d;
      line-height: 1.55;
    }

    .header-flex {
      display: flex;
      align-items: end;
      gap: 20px;
    }

    .section-title-small {
      font-size: 1.15rem;
      color: var(--color-accent);
      letter-spacing: 0.22em;
    }

    .header-flex .line {
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.07);
      margin-bottom: 6px;
    }

    .news-list {
      margin-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }

    .news-alert {
      display: grid;
      grid-template-columns: 120px 1fr auto;
      gap: 28px;
      align-items: center;
      padding: 22px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      border-left: 3px solid transparent;
      transition: background 0.2s ease, border-left-color 0.2s ease;
    }

    .news-alert:hover {
      background: rgba(255, 255, 255, 0.02);
      border-left-color: rgba(199, 157, 49, 0.4);
    }

    .news-alert.is-urgent {
      background: rgba(199, 157, 49, 0.05);
      border-left-color: var(--color-accent);
      border-bottom-color: rgba(199, 157, 49, 0.1);
    }

    .alert-badge-wrap {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .alert-star {
      color: var(--color-accent);
      font-size: 0.9rem;
      line-height: 1;
    }

    .alert-cat {
      display: inline-flex;
      align-items: center;
      height: 24px;
      padding: 0 10px;
      font-family: var(--font-accent);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      background: rgba(199, 157, 49, 0.1);
      color: var(--color-accent);
    }

    .news-alert.is-urgent .alert-cat {
      background: var(--color-accent);
      color: #050505;
    }

    .alert-content {
      min-width: 0;
    }

    .alert-heading {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }

    .alert-title {
      color: #fff;
      font-size: 1.08rem;
      font-weight: 700;
      line-height: 1.25;
    }

    .alert-date {
      color: #4a4a4a;
      font-size: 0.76rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .alert-excerpt {
      color: #888;
      font-size: 0.88rem;
      line-height: 1.52;
    }

    .alert-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .alert-pills li {
      padding: 4px 8px;
      border: 1px solid rgba(199, 157, 49, 0.18);
      color: #c8c8c8;
      font-size: 0.8rem;
    }

    .alert-action {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border: 1px solid rgba(199, 157, 49, 0.25);
      color: var(--color-accent);
      font-family: var(--font-accent);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .alert-action:hover {
      background: var(--color-accent);
      color: #050505;
      border-color: var(--color-accent);
    }

    .news-alert.is-urgent .alert-action {
      background: var(--color-accent);
      color: #050505;
      border-color: transparent;
    }

    .news-alert.is-urgent .alert-action:hover {
      background: #fff;
      color: #050505;
      border-color: transparent;
    }

    .schedule-header {
      margin-bottom: 20px;
    }

    .schedule-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .schedule-item {
      display: grid;
      gap: 14px;
      align-content: start;
      padding: 18px;
      border-top: 2px solid var(--color-accent);
      background: rgba(255, 255, 255, 0.03);
      border-right: 1px solid rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      border-left: 1px solid rgba(255, 255, 255, 0.04);
    }

    .item-day {
      color: var(--color-accent);
      font-family: var(--font-accent);
      font-size: 1.5rem;
      letter-spacing: 0.05em;
      line-height: 1;
    }

    .item-slots {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .item-slot {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 10px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .item-slot:first-child {
      padding-top: 0;
      border-top: none;
    }

    .item-type {
      color: #fff;
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.4;
    }

    .item-time {
      color: #d8d8d8;
      font-size: 0.95rem;
      font-family: var(--font-accent);
      letter-spacing: 0.08em;
    }

    .faq-header {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 6px;
      margin-bottom: 24px;
    }

    .faq-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .faq-item {
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.025);
    }

    .faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 18px 20px;
      color: #fff;
      font-family: var(--font-accent);
      font-size: 1.2rem;
      letter-spacing: 0.04em;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item p {
      padding: 0 20px 18px;
      color: #a9a9a9;
      line-height: 1.55;
    }

    .faq-item[open] {
      border-color: rgba(199, 157, 49, 0.18);
    }

    .reveal {
      opacity: 1;
      transform: none;
    }

    :global(html.reveal-ready) .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(html.reveal-ready) .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 1080px) {
      .stat-item {
        padding: 0 32px;
      }

      .intro-grid,
      .schedule-header {
        grid-template-columns: 1fr;
      }

      .schedule-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .faq-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .highlights-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 820px) {
      .hero {
        padding-top: 116px;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px 0;
      }

      .stat-item {
        padding: 0 20px;
      }

      .stat-sep {
        display: none;
      }

      .hero-bg-name,
      .hero-decor-line {
        display: none;
      }

      .highlights-grid {
        grid-template-columns: 1fr;
      }

      .faq-list {
        grid-template-columns: 1fr;
      }

      .header-flex {
        flex-direction: column;
        align-items: start;
        gap: 12px;
      }

      .header-flex .line {
        width: 100%;
      }

      .news-alert {
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
        gap: 12px 16px;
        align-items: start;
      }

      .alert-badge-wrap {
        grid-row: 1;
        grid-column: 1;
      }

      .alert-action {
        grid-row: 1;
        grid-column: 2;
        justify-self: end;
        align-self: center;
      }

      .alert-content {
        grid-row: 2;
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 640px) {
      .hero {
        padding: 108px 0 62px;
      }

      .hero-title {
        font-size: 3.25rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .btn-main {
        width: 100%;
      }

      .hero-shell {
        max-width: none;
      }

      .highlight-card {
        padding: 16px;
      }

      .section-intro,
      .section-news,
